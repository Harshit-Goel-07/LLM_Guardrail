# Copy to `.env` (in the backend/ directory) and adjust as needed.
# All variables are prefixed with GUARDRAIL_.

# --- General ---
GUARDRAIL_ENVIRONMENT=development
GUARDRAIL_LOG_LEVEL=INFO

# --- Datastore ---
# Default: SQLite file under backend/var/. To use Postgres instead:
# GUARDRAIL_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/guardrail
# GUARDRAIL_DATABASE_URL=sqlite:///./var/guardrail.db

# --- LLM provider: mock | ollama | openai ---
GUARDRAIL_LLM_PROVIDER=mock

# Ollama (local) — requires a running Ollama daemon with the model pulled.
# GUARDRAIL_OLLAMA_BASE_URL=http://localhost:11434
# GUARDRAIL_OLLAMA_MODEL=llama3.2

# OpenAI / OpenAI-compatible — key read from env only, never hard-code it.
# GUARDRAIL_OPENAI_API_KEY=sk-...
# GUARDRAIL_OPENAI_BASE_URL=https://api.openai.com/v1
# GUARDRAIL_OPENAI_MODEL=gpt-4o-mini

# --- Detection tuning ---
GUARDRAIL_BLOCK_THRESHOLD=70
GUARDRAIL_SEMANTIC_HIT_THRESHOLD=0.60
GUARDRAIL_WEIGHT_HEURISTICS=0.55
GUARDRAIL_WEIGHT_SEMANTIC=0.45
# Embedding backend: auto | minilm | tfidf
GUARDRAIL_EMBEDDING_BACKEND=auto
